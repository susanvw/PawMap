{
  "expo": {
    "name": "PawMap",
    "slug": "paw-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.svwdesign.pawmap"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.svwdesign.pawmap",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "PawMap uses your camera to photograph found pets."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PawMap uses your location to record where a pet was found."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6f0582d8-944a-45d8-accd-be812b7d0693"
      }
    },
    "owner": "svwdesign"
  }
}
